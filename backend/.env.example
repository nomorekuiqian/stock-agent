# ============================================================================
# Backend env template — 复制为 backend/.env，按 docs/contributing.md C7 填写。
#
#   L1 = 你自己注册（推荐主路径，退出时主理人不用 revoke）
#   L2 = 找主理人通过 onetimesecret.com 一次性链接要
#   L3 = 主理人独占，本地留空也能跑
# ============================================================================

# ----- 基础配置（本地用这些默认值即可，永远不要改成 production）-----
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ============================================================================
# L1 — 自己注册
# ============================================================================

# Google AI (Gemini) — https://aistudio.google.com/apikey
# Interactive agents default to gemini-3.1-flash-lite; override only when needed.
GOOGLE_API_KEY=
RESEARCH_AGENT_MODEL=gemini-3.1-flash-lite
KOL_RESEARCH_MODEL=gemini-3.1-flash-lite

# OpenAI — https://platform.openai.com/api-keys （可选备用 AI）
OPENAI_API_KEY=

# DeepSeek — https://platform.deepseek.com/api_keys （可选备用 AI）
DEEPSEEK_API_KEY=

# Langfuse observability — https://langfuse.com
# Optional. When both keys are present, backend startup traces Google ADK,
# direct Google GenAI, and DeepSeek LLM calls.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_CAPTURE_CONTENT=true

# Financial Modeling Prep — https://site.financialmodelingprep.com/developer/docs
# 免费 tier 250 req/day
FMP_API_KEY=

# FRED — https://fred.stlouisfed.org/docs/api/api_key.html
# 完全免费
FRED_API_KEY=

# Alpha Vantage — https://www.alphavantage.co/support/#api-key （可选）
ALPHA_VANTAGE_API_KEY=

# Twitter / X API — https://developer.twitter.com （可选，仅 KOL 功能需要）
TWITTER_API_KEY=

# Resend — https://resend.com/api-keys
# 免费 100/day, 3000/月。本地只能发到自己 Resend 验证过的邮箱
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=onboarding@resend.dev

# Stripe test mode — https://dashboard.stripe.com/test/apikeys
# 朋友自己在 Stripe test mode 创建 Pro / Max / Ultra 三个 Product，填对应 price id
# 测试卡号: 4242 4242 4242 4242
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PRO_PRICE_ID=price_test_xxx
STRIPE_MAX_PRICE_ID=price_test_xxx
STRIPE_ULTRA_PRICE_ID=price_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_test_xxx

# ============================================================================
# L2 — 公开默认值，直接用即可（anon key 本来就要进前端 bundle，不是 secret）
# ============================================================================

# Insforge（PostgreSQL + Edge Functions + Auth）
INSFORGE_BASE_URL=https://9wmhxyi4.us-east.insforge.app
INSFORGE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3OC0xMjM0LTU2NzgtOTBhYi1jZGVmMTIzNDU2NzgiLCJlbWFpbCI6ImFub25AaW5zZm9yZ2UuY29tIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjY5NjYwMTB9.NcVDw3fQS9-hUslOR5u3d3hfNiRE7LPui0lE2aDUdOA

# 共享开发邀请码（如果要走注册测试流程，找主理人要）
INVITE_CODES=

# ============================================================================
# L3 — 主理人独占，朋友本地留空即可
# 留空时，相关功能会优雅降级或返回权限错；不影响其他模块
# ============================================================================

# Insforge 超管 key（绕过 RLS）
INSFORGE_SERVICE_KEY=

# 定时任务 / Edge function 身份令牌
CRON_SECRET=
EDGE_FUNCTION_SECRET=

# 微信小程序（仅做微信功能需要）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_JWT_SECRET=

# Resend 主理人账号的生产 segment / audience id
# 朋友用自己的 Resend 不需要这些
RESEND_SEGMENT_MORNING=
RESEND_SEGMENT_EVENING=
RESEND_SEGMENT_WEEKLY=
RESEND_SEGMENT_TWITTER_DIGEST=
RESEND_AUDIENCE_TWITTER_DIGEST=

# Admin 邮箱白名单（本地无所谓，影响生产 /admin 路由）
ADMIN_EMAILS=

# Pro 邮件门控开关（本地建议 false）
EMAIL_PRO_GATE=false
