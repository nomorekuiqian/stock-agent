@@ -0,0 +1,103 @@
+import { NextRequest, NextResponse } from 'next/server';
+import {
+  buildCookieOptions,
+  buildExpiredCookieOptions,
+  extractRefreshToken,
+} from '../helpers';
+
+const INSFORGE_BASE_URL =
+  process.env.NEXT_PUBLIC_INSFORGE_URL || 'https://9wmhxyi4.us-east.insforge.app';
+const INSFORGE_ANON_KEY = process.env.NEXT_PUBLIC_INSFORGE_ANON_KEY || '';
+
+export async function GET(request: NextRequest) {
+  const code = request.nextUrl.searchParams.get('insforge_code');
+  const destination = request.nextUrl.searchParams.get('destination') || '/today';
+  const verifier = request.cookies.get('insforge-pkce-verifier')?.value;
+
+  const safeDest = destination.startsWith('/') ? destination : '/today';
+
+  if (!code || !verifier) {
+    console.error(
+      '[auth/oauth-callback] missing params: code=%s verifier=%s',
+      code ? 'present' : 'missing',
+      verifier ? 'present' : 'missing',
+    );
+    return NextResponse.redirect(new URL('/login?error=oauth_failed', request.url));
+  }
+
+  try {
+    const res = await fetch(`${INSFORGE_BASE_URL}/api/auth/oauth/exchange`, {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/json',
+        Authorization: `Bearer ${INSFORGE_ANON_KEY}`,
+        apikey: INSFORGE_ANON_KEY,
+      },
+      body: JSON.stringify({ code, code_verifier: verifier }),
+      cache: 'no-store',
+    });
+
+    if (!res.ok) {
+      let body: string;
+      try {
+        body = await res.text();
+      } catch {
+        body = '(unreadable)';
+      }
+      console.error(
+        '[auth/oauth-callback] exchange failed: status=%d body=%s',
+        res.status,
+        body.slice(0, 200),
+      );
+      return NextResponse.redirect(new URL('/login?error=oauth_exchange_failed', request.url));
+    }
+
+    const data = await res.json();
+    if (!data.accessToken || !data.user) {
+      console.error('[auth/oauth-callback] exchange returned no token or user');
+      return NextResponse.redirect(new URL('/login?error=oauth_no_token', request.url));
+    }
+
+    const refreshToken = extractRefreshToken(res);
+    console.log(
+      '[auth/oauth-callback] success: refreshToken=%s csrf=%s',
+      refreshToken ? 'present' : 'missing',
+      data.csrfToken ? 'present' : 'missing',
+    );
+
+    const response = NextResponse.redirect(new URL(safeDest, request.url));
+
+    response.cookies.set(
+      'insforge-session',
+      data.accessToken,
+      buildCookieOptions(request, true, 60 * 60 * 24 * 7),
+    );
+
+    if (refreshToken) {
+      response.cookies.set(
+        'insforge-refresh',
+        refreshToken,
+        buildCookieOptions(request, true, 60 * 60 * 24 * 30),
+      );
+    }
+
+    if (data.csrfToken) {
+      response.cookies.set(
+        'insforge-csrf',
+        data.csrfToken,
+        buildCookieOptions(request, true, 60 * 60 * 24 * 30),
+      );
+    }
+
+    response.cookies.set(
+      'insforge-pkce-verifier',
+      '',
+      buildExpiredCookieOptions(request),
+    );
+
+    return response;
+  } catch (err) {
+    console.error('[auth/oauth-callback] error:', err);
+    return NextResponse.redirect(new URL('/login?error=oauth_error', request.url));
+  }
+}
