#!/bin/sh

# Post-commit hook: 自动将 commit 记录追加到 Obsidian 开发日志
# 格式: hash + title + body（不含文件列表）

DEVLOG_PATH="$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/TheMarketBrew增长/产品/开发日志.md"

# 如果 devlog 文件不存在则跳过
if [ ! -f "$DEVLOG_PATH" ]; then
  exit 0
fi

# 获取东部时间日期
TODAY=$(TZ='America/New_York' date +%Y-%m-%d)

# 获取 commit 信息
COMMIT_HASH=$(git log -1 --format='%h')
COMMIT_TITLE=$(git log -1 --format='%s' | head -1)

# 获取 body（去掉 Co-Authored-By 行和空行）
COMMIT_BODY=$(git log -1 --format='%b' | grep -v '^Co-Authored-By:' | grep -v '^$' | sed 's/^/  /')

# 如果今天的日期标题不存在，添加一个
if ! grep -q "### $TODAY" "$DEVLOG_PATH" 2>/dev/null; then
  echo "" >> "$DEVLOG_PATH"
  echo "### $TODAY" >> "$DEVLOG_PATH"
fi

# 追加 commit 记录：title + body
echo "- \`$COMMIT_HASH\` $COMMIT_TITLE" >> "$DEVLOG_PATH"
if [ -n "$COMMIT_BODY" ]; then
  echo "$COMMIT_BODY" >> "$DEVLOG_PATH"
fi
