# ============================================================================
# Frontend env template — 复制为 frontend/.env.local
# 详细分级见 docs/contributing.md 的 C7 章节
# ============================================================================

# ----- 本地后端地址（默认值即可）-----
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ----- Insforge（公开 anon key，直接用以下默认值即可）-----
# 这是 Insforge 实例的 URL 和 anon JWT —— 都是前端 bundle 内的公开值，
# 不是 secret，可以直接 commit。
NEXT_PUBLIC_INSFORGE_URL=https://9wmhxyi4.us-east.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3OC0xMjM0LTU2NzgtOTBhYi1jZGVmMTIzNDU2NzgiLCJlbWFpbCI6ImFub25AaW5zZm9yZ2UuY29tIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjY5NjYwMTB9.NcVDw3fQS9-hUslOR5u3d3hfNiRE7LPui0lE2aDUdOA

# ----- Paywall 开关（本地建议关）-----
NEXT_PUBLIC_ENABLE_PAYWALL=false
NEXT_PUBLIC_STRIPE_LIVE=false

# ----- PostHog product analytics（公开 project API key，不是 secret）-----
# Vercel production 里填 PostHog project API key；本地留空则禁用。
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ----- Cron auth（前端 server action 用，留空即可）-----
CRON_SECRET=
