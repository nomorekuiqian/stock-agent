<nav-bar title="TheMarketBrew" />

<view class="container home-page">
  <!-- Editorial Header -->
  <view class="home-header">
    <view class="editorial-label">
      <view class="editorial-line"></view>
      <text class="text-label">MARKET INTELLIGENCE</text>
    </view>
    <view class="home-title">市场洞察</view>
    <view class="home-subtitle">AI 驱动的每日行情分析与投研工具</view>
  </view>

  <!-- Loading skeleton -->
  <view wx:if="{{loading}}" class="card-list">
    <view class="card skeleton-card" wx:for="{{3}}" wx:key="index">
      <view class="skeleton-icon skeleton"></view>
      <view class="skeleton-body">
        <view class="skeleton skeleton-title"></view>
        <view class="skeleton skeleton-subtitle"></view>
      </view>
    </view>
  </view>

  <!-- Content cards -->
  <view class="card-list" wx:else>
    <view
      class="content-card card"
      wx:for="{{cards}}"
      wx:key="id"
      data-url="{{item.url}}"
      bind:tap="onCardTap"
      hover-class="content-card-hover"
    >
      <!-- Left accent bar -->
      <view class="card-accent" style="background: {{item.accentColor || 'var(--emerald)'}}"></view>

      <view class="card-inner">
        <!-- Icon -->
        <view class="card-icon-wrap" style="background: {{item.iconBg || 'var(--emerald-dim)'}}">
          <text class="card-icon-text" style="color: {{item.accentColor || 'var(--emerald)'}}">{{item.iconChar || ''}}</text>
        </view>

        <!-- Text -->
        <view class="card-body">
          <view class="card-title">{{item.title}}</view>
          <view class="card-subtitle">{{item.subtitle}}</view>
        </view>

        <!-- Arrow -->
        <view class="card-arrow">
          <view class="arrow-chevron"></view>
        </view>
      </view>
    </view>
  </view>
</view>
